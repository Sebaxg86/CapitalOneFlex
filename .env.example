# Copiar a .env.local y rellenar. NUNCA versionar .env.local.
# Todas estas variables se leen SOLO en servidor. No usar prefijo NEXT_PUBLIC.

# Gemini API (Google AI Studio -> https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Identificador exacto del modelo accesible con salida estructurada.
# Claude lo detecta y lo escribe aqui tras verificar acceso de la cuenta.
GEMINI_MODEL=

# Tiger Data: URI PostgreSQL del servicio dedicado a este prototipo.
# Formato orientativo:
# postgresql://USUARIO:CLAVE_CODIFICADA@HOST:PUERTO/BASE?sslmode=require
DATABASE_URL=

# Fecha economica fija del dataset (America/Monterrey). No depender del reloj local.
DEMO_TODAY=2026-09-12
